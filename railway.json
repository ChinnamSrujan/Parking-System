{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd smart-parking-backend && mvn clean package -DskipTests"
  },
  "deploy": {
    "startCommand": "java -jar smart-parking-backend/target/smart-parking-backend-1.0.0.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
